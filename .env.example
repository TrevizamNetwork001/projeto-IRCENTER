APP_NAME=IRCENTER
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ircenter.example.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
BUSINESS_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ircenter
DB_USERNAME=ircenter
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE=false

CACHE_STORE=redis
CACHE_PREFIX=ircenter-cache-

QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Documentação Técnica — integração somente leitura
DOCUMENTATION_API_TOKEN_HASH=
DOCUMENTATION_API_RATE_LIMIT=120

# IRCENTER Financeiro & Fiscal
FINANCE_FISCAL_DB_CONNECTION=pgsql
FINANCE_FISCAL_DB_HOST=postgres
FINANCE_FISCAL_DB_PORT=5432
FINANCE_FISCAL_DB_DATABASE=
FINANCE_FISCAL_DB_USERNAME=
FINANCE_FISCAL_DB_PASSWORD=
FINANCE_FISCAL_DB_SSLMODE=prefer

FINANCE_ENABLED=false
FINANCE_AUTOMATION_ENABLED=false
PAYMENT_PROVIDER=fake
PAYMENT_LIVE_ENABLED=false

FISCAL_ENABLED=false
NFSE_PROVIDER=fake
NFSE_TRANSMISSION_ENABLED=false
NFSE_LIVE_ENABLED=false

FINANCE_GENERAL_EMAIL_FALLBACK=false


# Efí API Cobranças
EFI_ENVIRONMENT=homologation
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_NOTIFICATION_URL=

PAYMENT_WEBHOOKS_ENABLED=false
